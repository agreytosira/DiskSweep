/* Hallmark: utilitarian terminal workbench; personal use, cobalt focus.
 * Pre-emit critique: Philosophy 4, Hierarchy 4, Execution 4, Specificity 5, Restraint 5, Variety 4.
 * Terminal-native controls and typography; no website chrome or decorative motion. */
$surface: #16202b;
$paper: #101820;
$ink: #e0e8ef;
$muted: #9aacbd;
$focus: #66adff;
$rule: #334657;

Screen { background: $paper; color: $ink; }
Header { background: $surface; color: $ink; }
Footer { background: $surface; }
#intro { height: 1; padding: 0 1; color: $muted; }
#scan-controls, #options, #filters { height: 3; margin: 0 1; }
#scan-controls { margin-bottom: 0; }
#target { width: 24; margin-right: 1; }
#root { width: 1fr; margin-right: 1; }
#scan, #stop { min-width: 8; width: 10; margin-left: 1; }
#scan-mode { width: 26; }
.field-label { width: auto; padding: 1 1; }
#age, #min-size { width: 9; }
#status { height: 1; padding: 0 1; color: $muted; }
#totals { height: 1; padding: 0 1; color: $focus; text-style: bold; }
#search { width: 1fr; margin-right: 1; }
#category { width: 23; margin-right: 1; }
#sort { width: 19; }
#files { height: 1fr; min-height: 3; margin: 0 1; border: solid $rule; }
#files:focus { border: solid $focus; }
#details { height: 2; padding: 0 1; color: $muted; }
#actions { height: 3; margin: 0 1; }
#actions Button { width: auto; min-width: 10; margin-right: 1; }
#page-label { height: 3; width: 1fr; min-width: 12; content-align: center middle; }
#previous, #next { min-width: 6; width: 6; }
ModalScreen { align: center middle; background: $paper 85%; }
.dialog {
    width: 90%; max-width: 120; height: 90%; padding: 0 1;
    background: $surface; border: solid $focus;
}
.dialog-title { height: 1; text-style: bold; color: $focus; }
#review-table, #message-body { height: 1fr; margin: 1 0; }
#removal-mode { height: 3; }
#removal-note { height: 2; color: $muted; }
#confirmation { height: 3; margin-bottom: 1; }
.dialog-buttons { height: 3; align-horizontal: right; }
.dialog-buttons Button { width: auto; margin-left: 1; }
#close { dock: bottom; width: 100%; }
